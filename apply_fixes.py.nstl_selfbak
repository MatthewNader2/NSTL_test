PRUNE_SRC = '''
def _prune_tunnel_stratified(self, tunnel_cells, relevance_map,
                             num_semantic_clauses: int = 1,
                             max_s1=None, max_s2=None, max_s3=None):
    """(apply_fixes_v6) Stratified pruning; caps scale with task size."""
    n = max(int(num_semantic_clauses or 1), 1)
    max_s1 = max_s1 if max_s1 is not None else max(12, n * 2)
    max_s2 = max_s2 if max_s2 is not None else max(38, n * 6)
    max_s3 = max_s3 if max_s3 is not None else max(8,  n * 2)

    def _stage_num(c):
        st = getattr(c, 'stage', -1)
        if isinstance(st, int): return st
        st_str = str(st).strip().upper()
        return 1 if st_str in ('1', 'S1', 'INGRESS') else (
               2 if st_str in ('2', 'S2', 'TRANSFORM') else (
               3 if st_str in ('3', 'S3', 'EGRESS', 'SINK') else 0))

    protected_ids = {c.cell_id for c in tunnel_cells if relevance_map.get(c.cell_id, 0.0) >= 0.05}
    s1 = sorted([c for c in tunnel_cells if _stage_num(c) == 1],
                key=lambda c: relevance_map.get(c.cell_id, 0.0), reverse=True)[:max_s1]
    s2 = sorted([c for c in tunnel_cells if _stage_num(c) == 2],
                key=lambda c: relevance_map.get(c.cell_id, 0.0), reverse=True)[:max_s2]
    s3 = sorted([c for c in tunnel_cells if _stage_num(c) == 3],
                key=lambda c: relevance_map.get(c.cell_id, 0.0), reverse=True)[:max_s3]
    keep_ids = {c.cell_id for c in s1 + s2 + s3} | protected_ids
    return [c for c in tunnel_cells if c.cell_id in keep_ids] or tunnel_cells
'''.strip()

IR_HOOK_BLOCK = '''        # (apply_fixes_v6) IR compiler hook
        try:
            from config import settings as _s
            self._use_ir_compiler = bool(getattr(_s, "use_ir_compiler", True))
        except Exception:
            self._use_ir_compiler = True
        self._ir_compiler = None
        if self._use_ir_compiler:
            try:
                from ir_compiler import IRCompiler
                self._ir_compiler = IRCompiler(self.orchestrator)
            except Exception as _e:
                logger.warning("IR compiler unavailable: %s", _e)
        self._last_ir_steps = 0'''

ROUTE_IR_BLOCK = '''        # (apply_fixes_v6) IR compilation drives semantic clause count.
        num_semantic_clauses = 0
        if getattr(self, "_use_ir_compiler", False) and self._ir_compiler is not None:
            try:
                _ir = self._ir_compiler.compile(prompt)
                if _ir is not None:
                    ops = " ".join(s.get("op", "") for s in _ir.steps)
                    libs = " ".join(_ir.libraries)
                    prompt = (prompt + " " + ops + " " + libs).strip()
                    num_semantic_clauses = len(_ir.steps)
                    self._last_ir_steps = num_semantic_clauses
            except Exception as _e:
                logger.debug("[IR] augmentation failed: %s", _e)'''

def fix_router(txn):
    p = SRC / "router.py"
    if not p.exists(): print("  [miss] router.py"); return False
    t = p.read_text(encoding="utf-8")

    if "_segment_prompt_clauses" not in t:
        t = t.replace("from .planner import LatticePlanner, STOPWORDS\n",
                      "from .planner import LatticePlanner, STOPWORDS, _segment_prompt_clauses\n", 1)
        t = t.replace("from planner import LatticePlanner, STOPWORDS\n",
                      "from planner import LatticePlanner, STOPWORDS, _segment_prompt_clauses\n", 1)
        print("  [ok]   router.py: import _segment_prompt_clauses")

    if "_ir_compiler = None" not in t:
        m = re.search(r"(self\.planner\s*=\s*LatticePlanner\([^\)]*\)\s*\n)", t)
        if m:
            t = t[:m.end()] + IR_HOOK_BLOCK + "\n" + t[m.end():]
            print("  [ok]   router.py: IR hook in __init__")

    if "num_semantic_clauses = 0" not in t:
        try: tree = ast.parse(t)
        except SyntaxError: tree = None
        if tree:
            route_m = None
            for cls in tree.body:
                if isinstance(cls, ast.ClassDef) and cls.name == "LatticeRouter":
                    for m in cls.body:
                        if isinstance(m, ast.FunctionDef) and m.name == "route":
                            route_m = m; break
                    break
            if route_m:
                first_if = next((s for s in route_m.body if isinstance(s, ast.If)), None)
                if first_if:
                    lines = t.splitlines(keepends=True)
                    t = "".join(lines[:first_if.end_lineno]) + ROUTE_IR_BLOCK + "\n" + "".join(lines[first_if.end_lineno:])
                    print("  [ok]   router.py: route() IR block")

    t = _literal_replace(
        t,
        "        clauses = [c.strip() for c in re.split(r'[,;]|\\b(?:and|then)\\b', prompt.strip()) if c.strip()]\n",
        "        clauses = _segment_prompt_clauses(prompt)\n        if not num_semantic_clauses:\n            num_semantic_clauses = len(clauses)\n",
        "router.py: shared segmenter",
    )
    t = _literal_replace(
        t,
        "        final_tunnel = self._prune_tunnel_stratified(final_tunnel, relevance_map)",
        "        final_tunnel = self._prune_tunnel_stratified(\n            final_tunnel, relevance_map,\n            num_semantic_clauses=num_semantic_clauses,\n        )",
        "router.py: pass num_semantic_clauses",
    )

    t2, ok, why = _replace_named(t, "_prune_tunnel_stratified", PRUNE_SRC, cls_name="LatticeRouter")
    if ok: t = t2; print("  [ok]   router.py: _prune_tunnel_stratified (RC3)")
    else:   print(f"  [warn] router.py: prune: {why}")

    txn.stage(p, t)
    return True

