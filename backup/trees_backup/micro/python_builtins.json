{
  "domain_name": "Python_Builtins",
  "version": "2.0.0",
  "description": "Core Python built-in operations — the bedrock of every pipeline. These micro-cells cover I/O, type casting, string manipulation, file handling, and control primitives.",
  "cells": [
    {
      "cell_id": "PYTHON_OPEN_FILE_READ",
      "type": "micro",
      "stage": 1,
      "keywords": ["open", "file", "read", "text", "load", "filesystem", "input"],
      "inputs":  { "type_name": "str", "state": "source_identifier" },
      "outputs": { "type_name": "str", "state": "raw_text" },
      "domain_implementations": {
        "Python_Core": {
          "code": "with open({input_var}, 'r', encoding='utf-8') as _fh:\n    {output_var} = _fh.read()",
          "dependencies": []
        }
      }
    },
    {
      "cell_id": "PYTHON_WRITE_FILE",
      "type": "micro",
      "stage": 1,
      "keywords": ["write", "save", "file", "output", "export", "text"],
      "inputs":  { "type_name": "str", "state": "raw_text" },
      "outputs": { "type_name": "str", "state": "filepath_written" },
      "domain_implementations": {
        "Python_Core": {
          "code": "_out_path = 'output.txt'\nwith open(_out_path, 'w', encoding='utf-8') as _fh:\n    _fh.write({input_var})\n{output_var} = _out_path",
          "dependencies": []
        }
      }
    },
    {
