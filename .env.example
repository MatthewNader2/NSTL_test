# NSTL Configuration — Copy to .env and customize
# All variables are optional; defaults are shown

# === Paths ===
# NSTL_TREES_DIR=trees
# NSTL_HARVESTS_DIR=harvests
# NSTL_LOGS_DIR=logs
# NSTL_MODELS_DIR=models

# === Server ===
# NSTL_API_HOST=127.0.0.1
# NSTL_API_PORT=58102

# === Sandbox ===
# NSTL_SANDBOX_TIMEOUT=5.0
# NSTL_SANDBOX_WORKERS=2
# NSTL_SANDBOX_MAX_MEMORY_MB=1024
# NSTL_SANDBOX_MAX_CPU_SECONDS=5

# === Inference ===
# NSTL_LLM_CONTEXT_LENGTH=2048
# NSTL_LLM_TEMPERATURE=0.1
# NSTL_LLM_TOP_P=0.95
