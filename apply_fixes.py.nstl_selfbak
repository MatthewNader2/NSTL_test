REGISTER_ALIAS_SRC = '''
def register_alias(self, alias: str, canonical: str):
    self._aliases[alias.strip().lower()] = canonical.strip()
    # (apply_fixes_v6) propagate to tokenizer
    try:
        from .tokenizer import register_aliases as _ra
    except ImportError:
        try: from tokenizer import register_aliases as _ra
        except ImportError: _ra = None
    if _ra is not None:
        try: _ra(self._aliases)
        except Exception: pass
'''.strip()

IDENTITY_TOKENS_SRC = '''
@property
def identity_tokens(self) -> Set[str]:
    if self._identity_tokens is None:
        toks = CellTokenizer.tokenize_cell(self.cell_id, self.keywords)
        # (apply_fixes_v6) RC4 — identity is operation-only.
        if getattr(self, "domain_name", None) and self.domain_name != "generic":
            dom_toks = CellTokenizer.tokenize_identifier(self.domain_name)
            toks = toks - dom_toks
        try:
            aliases = TypeRegistry.get_instance().get_all_aliases()
        except Exception:
            aliases = {}
        if aliases:
            toks = toks - {t for t in toks if t in aliases}
        for p in self.inputs: toks.update(CellTokenizer.tokenize_identifier(p))
        for p in self.outputs: toks.update(CellTokenizer.tokenize_identifier(p))
        self._identity_tokens = toks
    return self._identity_tokens
'''.strip()

ENUM_FIELD_BLOCK = '''        # (apply_fixes_v6) P6 — configurable enum-citation triggers
        self._enum_citation_triggers: Set[str] = set()'''

ENUM_METHODS = '''
def register_enum_citation_triggers(self, triggers) -> None:
    for t in triggers or ():
        s = str(t).strip().lower()
        if len(s) >= 2: self._enum_citation_triggers.add(s)

def get_enum_citation_triggers(self) -> FrozenSet[str]:
    return frozenset(self._enum_citation_triggers)
'''.strip()

def fix_lattice(txn):
    p = SRC / "lattice.py"
    if not p.exists(): print("  [miss] lattice.py"); return False
    t = p.read_text(encoding="utf-8")

    t2, ok, why = _replace_named(t, "register_alias", REGISTER_ALIAS_SRC, cls_name="TypeRegistry")
    if ok: t = t2; print("  [ok]   lattice.py: register_alias rewired")
    else:   print(f"  [warn] lattice.py: register_alias: {why}")

    t2, ok, why = _replace_named(t, "identity_tokens", IDENTITY_TOKENS_SRC, cls_name="Cell")
    if ok: t = t2; print("  [ok]   lattice.py: identity_tokens (RC4)")
    else:   print(f"  [warn] lattice.py: identity_tokens: {why}")

    if "_enum_citation_triggers" not in t:
        anchor = "        self._ancestry_cache: Dict[Tuple[str, FrozenSet[str]], bool] = {}"
        if anchor in t:
            t = t.replace(anchor, anchor + "\n" + ENUM_FIELD_BLOCK, 1)
            print("  [ok]   lattice.py: _enum_citation_triggers field")
        else:
            print("  [warn] lattice.py: _ancestry_cache anchor not found")

        t2, ok = _insert_before_named(t, "register_alias", ENUM_METHODS, cls_name="TypeRegistry")
        if ok:
            t = t2; print("  [ok]   lattice.py: register/get enum_citation_triggers")
        else:
            print("  [warn] lattice.py: could not insert enum methods")
    else:
        print("  [skip] lattice.py: enum triggers present")

    txn.stage(p, t)
    return True

