ALIAS_HELPERS = '''
# (apply_fixes_v6) Alias expansion. Tree JSON declares aliases; tokenizer
# expands tokens both ways so ``pd_dataframe_init`` matches "pandas".
_ALIASES: dict = {}
_ALIASES_REV: dict = {}

def register_aliases(mapping: dict) -> None:
    global _ALIASES, _ALIASES_REV
    clean = {str(k).strip().lower(): str(v).strip().lower()
             for k, v in (mapping or {}).items() if k and v}
    if clean == _ALIASES: return
    _ALIASES = clean
    rev: dict = {}
    for k, v in _ALIASES.items():
        rev.setdefault(v, set()).add(k)
    _ALIASES_REV = rev
    try: _tokenize_identifier_cached.cache_clear()
    except Exception: pass

def _expand_aliases(tokens):
    if not _ALIASES or not tokens: return tokens
    out = set(tokens)
    for t in tokens:
        c = _ALIASES.get(t)
        if c: out.add(c)
        r = _ALIASES_REV.get(t)
        if r: out.update(r)
    return out
'''.strip()

IDENT_CACHE_SRC = '''
def _tokenize_identifier_cached(identifier: str) -> FrozenSet[str]:
    clean = str(identifier).strip()
    if not clean: return frozenset()
    tokens: Set[str] = set()
    def _emit(chunk):
        t = "".join(chunk).lower().strip()
        if len(t) > 1:
            tokens.add(t)
            s = normalize_token(t)
            if len(s) > 1: tokens.add(s)
    seg, chunk = [], []
    for ch in clean:
        if ch.isalnum(): seg.append(ch)
        elif seg: _emit(seg); seg = []
    if seg: _emit(seg)
    n = len(clean)
    for i, ch in enumerate(clean):
        if not ch.isalnum():
            if chunk: _emit(chunk); chunk = []
            continue
        if chunk:
            p = chunk[-1]
            if (p.islower() and ch.isupper()) or (p.isupper() and ch.isupper() and i + 1 < n and clean[i + 1].islower()) or (p.isalpha() and ch.isdigit()) or (p.isdigit() and ch.isalpha()):
                _emit(chunk); chunk = [ch]; continue
        chunk.append(ch)
    if chunk: _emit(chunk)
    full = "".join(c for c in clean if c.isalnum() or c in ("_", "-")).lower().strip()
    if len(full) > 1: tokens.add(full)
    if _ALIASES:  # (apply_fixes_v6)
        tokens = _expand_aliases(tokens)
    return frozenset(tokens)
'''.strip()

TOKENIZE_PROMPT_SRC = '''
@classmethod
def tokenize_prompt(cls, prompt: str, remove_stopwords: bool = False) -> Set[str]:
    if not prompt: return set()
    tokens: Set[str] = set()
    cur = []
    for ch in prompt.lower():
        if ch.isalnum() or ch == '_': cur.append(ch)
        else:
            if cur:
                w = "".join(cur)
                if len(w) > 1 and (w[0].isalpha() or w[0] == '_'):
                    tokens.add(w)
                    if w.isalpha():
                        s = normalize_token(w)
                        if len(s) > 1: tokens.add(s)
                cur = []
    if cur:
        w = "".join(cur)
        if len(w) > 1 and (w[0].isalpha() or w[0] == '_'):
            tokens.add(w)
            if w.isalpha():
                s = normalize_token(w)
                if len(s) > 1: tokens.add(s)
    for raw in prompt.split():
        cw = raw.strip(",;.:!?()[]{}\\'\\"")
        if any(c.isupper() for c in cw) or '_' in cw or '.' in cw or any(c.isdigit() for c in cw):
            tokens.update(cls.tokenize_identifier(cw))
    if _ALIASES:  # (apply_fixes_v6)
        tokens = _expand_aliases(tokens)
    return tokens
'''.strip()

def fix_tokenizer(txn):
    p = SRC / "tokenizer.py"
    if not p.exists(): print("  [miss] tokenizer.py"); return False
    t = p.read_text(encoding="utf-8")

    if "_ALIASES: dict = {}" not in t:
        t2, ok = _insert_before_named(t, "_tokenize_identifier_cached", ALIAS_HELPERS)
        if ok:
            t = t2; print("  [ok]   tokenizer.py: inserted alias helpers")
        else:
            print("  [warn] tokenizer.py: cannot locate _tokenize_identifier_cached")
            return False
    else:
        print("  [skip] tokenizer.py: alias helpers present")

    t2, ok, why = _replace_named(t, "_tokenize_identifier_cached", IDENT_CACHE_SRC)
    if ok: t = t2; print("  [ok]   tokenizer.py: _tokenize_identifier_cached rewritten")
    else:   print(f"  [warn] tokenizer.py: {why}")

    t2, ok, why = _replace_named(t, "tokenize_prompt", TOKENIZE_PROMPT_SRC, cls_name="CellTokenizer")
    if ok: t = t2; print("  [ok]   tokenizer.py: tokenize_prompt rewritten")
    else:   print(f"  [warn] tokenizer.py: {why}")

    txn.stage(p, t)
    return True

