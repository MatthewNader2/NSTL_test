#!/usr/bin/env python3
"""
apply_fixes_v6.py — NSTL comprehensive fixes. Correct AST indentation.
Supersedes v3/v4/v5. Applies to a CLEAN source tree.
"""
from __future__ import annotations
import ast, re, shutil, sys, textwrap
from pathlib import Path

ROOT = Path(__file__).resolve().parent
SRC  = ROOT / "src"
if not SRC.is_dir():
    sys.exit(f"expected src/ next to this script; got {SRC}")

# ---------------------------------------------------------------------------
class _Txn:
    def __init__(self): self._staged: dict = {}
    def stage(self, p, t): self._staged[p] = t
    def staged(self): return dict(self._staged)
    def commit(self):
        for p, t in self._staged.items():
            if p.exists():
                b = p.with_suffix(p.suffix + ".nstl_backup")
                if not b.exists(): shutil.copy2(p, b)
            p.write_text(t, encoding="utf-8")
    def rollback(self): self._staged.clear()

def _find_target(tree, name, cls_name=None):
    if cls_name is None:
        for n in tree.body:
            if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and n.name == name:
                return n
    else:
        for cls in tree.body:
            if isinstance(cls, ast.ClassDef) and cls.name == cls_name:
                for m in cls.body:
                    if isinstance(m, (ast.FunctionDef, ast.AsyncFunctionDef)) and m.name == name:
                        return m
    return None

def _replace_named(text, name, new_body, cls_name=None):
    """Replace a function/method. new_body is DEDENTED, starts with 'def'/'@decorator'.
    Re-indents to match target's leading whitespace. Preserves original decorators
    if new_body has none."""
    try: tree = ast.parse(text)
    except SyntaxError as e:
        return text, False, f"parse error: {e}"
    target = _find_target(tree, name, cls_name)
    if target is None:
        return text, False, f"not found: {name}"
    start = target.lineno - 1
    if not new_body.lstrip().startswith("@"):
        for d in target.decorator_list:
            dl = d.lineno - 1
            if dl < start: start = dl
    end = target.end_lineno
    lines = text.splitlines(keepends=True)
    orig_first = lines[start]
    orig_indent = orig_first[:len(orig_first) - len(orig_first.lstrip())]
    dedented = textwrap.dedent(new_body).lstrip("\n")
    reindented = textwrap.indent(dedented, orig_indent)
    if not reindented.endswith("\n"): reindented += "\n"
    return "".join(lines[:start]) + reindented + "".join(lines[end:]), True, "ok"

def _insert_before_named(text, anchor_name, block, cls_name=None):
    try: tree = ast.parse(text)
    except SyntaxError: return text, False
    target = _find_target(tree, anchor_name, cls_name)
    if target is None: return text, False
    start = target.lineno - 1
    for d in target.decorator_list:
        dl = d.lineno - 1
        if dl < start: start = dl
    lines = text.splitlines(keepends=True)
    return "".join(lines[:start]) + block.rstrip("\n") + "\n\n" + "".join(lines[start:]), True

def _insert_after_line(text, substring, block):
    lines = text.splitlines(keepends=True)
    for i, ln in enumerate(lines):
        if substring in ln:
            return "".join(lines[:i+1]) + block.rstrip("\n") + "\n" + "".join(lines[i+1:]), True
    return text, False

def _literal_replace(text, old, new, label):
    if old not in text:
        print(f"  [skip] {label}"); return text
    print(f"  [ok]   {label}")
    return text.replace(old, new, 1)

