def fix_config(txn):
    p = SRC / "config.py"
    if not p.exists(): print("  [miss] config.py"); return False
    t = p.read_text(encoding="utf-8")

    if not re.search(r"^\s*import\s+os\s*$", t.split("\n\n", 1)[0], re.MULTILINE):
        t = "import os\n" + t
        print("  [ok]   config.py: import os")

    if "use_ir_compiler" not in t:
        anchor = '    topology_mode: str = "frontier"'
        block = ('    # (apply_fixes_v6) IR compiler is opt-out; no-ops in Profile 0/A.\n'
                 '    use_ir_compiler: bool = True\n'
                 '    planner_config: Optional[Path] = None')
        if anchor in t:
            t = t.replace(anchor, anchor + "\n" + block, 1)
            print("  [ok]   config.py: use_ir_compiler + planner_config")

    if "planner_config" in t and "self.planner_config is None" not in t:
        anchor = '            self.models_dir = self.project_root / "models"'
        block = ('        if getattr(self, "planner_config", None) is None:\n'
                 '            for _cand in (self.project_root / "config" / "planner.yaml",\n'
                 '                          self.project_root / "config" / "planner.json"):\n'
                 '                if _cand.exists():\n'
                 '                    self.planner_config = _cand\n'
                 '                    break')
        if anchor in t:
            t = t.replace(anchor, anchor + "\n" + block, 1)
            print("  [ok]   config.py: planner_config default")

    txn.stage(p, t)
    return True

# ===========================================================================
# ir_compiler.py (module-level, no re-indent needed)
# ===========================================================================
IR_SRC = '''"""
ir_compiler.py (apply_fixes_v6) — Prompt -> typed IR via the local LLM.
Runs whenever an LLM object is present; returns None in Profile 0/A.
"""
from __future__ import annotations
import json, re
from dataclasses import dataclass, field
from typing import Any, Dict, List, Optional

from log_config import get_logger
try:
    from .inference import ModelManager
except (ImportError, ValueError):
    from inference import ModelManager

logger = get_logger("ir_compiler")

IR_SCHEMA = {
    "type": "object",
    "required": ["steps"],
    "properties": {
        "libraries": {"type": "array", "items": {"type": "string"}},
        "steps": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["op"],
                "properties": {
                    "op":      {"type": "string"},
                    "params":  {"type": "object"},
                    "library": {"type": "string"},
                },
            },
        },
        "literals": {"type": "object"},
    },
}

PROMPT_TEMPLATE = """\\
You are a semantic compiler. Convert the user request into a typed IR.

Allowed `op` values (from the loaded tree vocabulary):
{vocab}

Allowed libraries: {libs}

Rules:
- One `op` per semantic action. Do NOT split on commas inside lists.
- Do NOT invent ops outside the vocabulary.
- Extract EVERY literal into `literals`.
- Return ONLY JSON.

User prompt:
{prompt}
"""

@dataclass
class IR:
    steps: List[Dict[str, Any]]
    literals: Dict[str, int] = field(default_factory=dict)
    libraries: List[str] = field(default_factory=list)
    raw: str = ""

    @classmethod
    def parse(cls, text: str) -> "IR":
        m = re.search(r"\\{.*\\}", text, re.DOTALL)
        if not m:
            raise ValueError("IR compiler: no JSON in output")
        data = json.loads(m.group(0))
        return cls(
            steps=data.get("steps", []),
            literals={str(k): int(v) for k, v in (data.get("literals") or {}).items()},
            libraries=list(data.get("libraries") or []),
            raw=text,
        )

    def validate(self, vocab: set) -> List[str]:
        return [f"step {i}: unknown op {s.get('op')!r}"
                for i, s in enumerate(self.steps) if s.get("op") not in vocab]

class IRCompiler:
    def __init__(self, orchestrator):
        self.orchestrator = orchestrator
        self.vocab = self._derive_vocab()
        self.libs  = self._derive_libs()

    def _derive_vocab(self) -> set:
        out = set()
        for c in self.orchestrator.loaded_cells.values():
            for tag in getattr(c, "semantic_tags", []) or []:
                tag = str(tag).strip().lower()
                if len(tag) > 2 and " " not in tag: out.add(tag)
            for kw in getattr(c, "keywords", []) or []:
                kw = str(kw).strip().lower()
                if len(kw) > 2 and " " not in kw: out.add(kw)
        return out or {"read", "transform", "filter", "aggregate", "plot", "save"}

    def _derive_libs(self) -> list:
        return sorted({c.domain_name for c in self.orchestrator.loaded_cells.values()
                       if getattr(c, "domain_name", None)})

    def compile(self, prompt: str) -> Optional[IR]:
        mm = ModelManager.get_instance()
        prof = getattr(mm, "profile", None)
        if prof is None: return None
        if getattr(prof, "llm", None) is None: return None
        msg = PROMPT_TEMPLATE.format(
            vocab=sorted(self.vocab)[:200], libs=sorted(self.libs), prompt=prompt)
        try:
            raw = mm.generate_text(msg, max_tokens=1024, schema=IR_SCHEMA)
            ir = IR.parse(raw)
            errs = ir.validate(self.vocab)
            if errs: logger.warning("[IR] vocab violations: %s", errs)
            return ir
        except Exception as e:
            logger.warning("[IR] compilation failed: %s", e)
            return None
'''

def fix_ir_compiler(txn):
    txn.stage(SRC / "ir_compiler.py", IR_SRC)
    print("  [ok]   ir_compiler.py written")

