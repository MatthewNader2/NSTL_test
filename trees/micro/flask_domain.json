{
  "domain_name": "Flask_Web_Framework",
  "version": "2.0.0",
  "description": "Flask REST API micro-cells. Covers app creation, routing, request parsing, JSON responses, database integration, authentication patterns, and server startup.",
  "cells": [
    {
      "cell_id": "FLASK_CREATE_APP",
      "type": "micro",
      "stage": 1,
      "keywords": ["flask", "app", "create", "init", "application", "web", "server"],
      "inputs":  { "type_name": "str", "state": "source_identifier" },
      "outputs": { "type_name": "Flask", "state": "app_instance" },
      "domain_implementations": {
        "Python_Core": {
          "code": "from flask import Flask\n{output_var} = Flask({input_var})",
          "dependencies": ["flask"]
        }
      }
    },
    {
      "cell_id": "FLASK_ADD_GET_ROUTE",
      "type": "micro",
      "stage": 2,
      "keywords": ["route", "get", "endpoint", "handler", "http", "rest"],
      "inputs":  { "type_name": "Flask", "state": "app_instance" },
      "outputs": { "type_name": "Flask", "state": "routed_app" },
      "domain_implementations": {
        "Python_Core": {
          "code": "from flask import jsonify\n@{input_var}.route('/api/data', methods=['GET'])\ndef get_data():\n    return jsonify({'status': 'ok', 'data': []})\n{output_var} = {input_var}",
          "dependencies": ["flask"]
        }
      }
    },
    {
      "cell_id": "FLASK_ADD_POST_ROUTE",
      "type": "micro",
      "stage": 2,
      "keywords": ["route", "post", "create", "insert", "endpoint", "rest", "handler"],
      "inputs":  { "type_name": "Flask", "state": "routed_app" },
      "outputs": { "type_name": "Flask", "state": "routed_app" },
      "domain_implementations": {
        "Python_Core": {
          "code": "from flask import request, jsonify\n@{input_var}.route('/api/data', methods=['POST'])\ndef create_data():\n    body = request.get_json()\n    if not body:\n        return jsonify({'error': 'No JSON body'}), 400\n    return jsonify({'status': 'created', 'received': body}), 201\n{output_var} = {input_var}",
          "dependencies": ["flask"]
        }
      }
    },
    {
      "cell_id": "FLASK_SQLITE_CONNECT",
      "type": "micro",
      "stage": 2,
      "keywords": ["sqlite", "database", "db", "connect", "sql", "storage"],
      "inputs":  { "type_name": "Flask", "state": "routed_app" },
      "outputs": { "type_name": "Flask", "state": "db_connected_app" },
      "domain_implementations": {
        "Python_Core": {
          "code": "import sqlite3\nimport os\n_db_path = 'app.db'\n_conn = sqlite3.connect(_db_path)\n_conn.execute('CREATE TABLE IF NOT EXISTS records (id INTEGER PRIMARY KEY, data TEXT)')\n_conn.commit()\n_conn.close()\nprint(f'SQLite DB initialized at {_db_path}')\n{output_var} = {input_var}",
          "dependencies": ["flask"]
        }
      }
    },
    {
      "cell_id": "FLASK_ENABLE_CORS",
      "type": "micro",
      "stage": 2,
      "keywords": ["cors", "cross-origin", "headers", "frontend", "allow"],
      "inputs":  { "type_name": "Flask", "state": "app_instance" },
      "outputs": { "type_name": "Flask", "state": "cors_enabled_app" },
      "domain_implementations": {
        "Python_Core": {
          "code": "from flask_cors import CORS\nCORS({input_var})\n{output_var} = {input_var}",
          "dependencies": ["flask", "flask-cors"]
        }
      }
    },
    {
      "cell_id": "FLASK_JSON_RESPONSE",
      "type": "micro",
      "stage": 3,
      "keywords": ["json", "response", "jsonify", "return", "api", "serialise"],
      "inputs":  { "type_name": "dict", "state": "parsed_object" },
      "outputs": { "type_name": "str", "state": "http_response" },
      "domain_implementations": {
        "Python_Core": {
          "code": "from flask import jsonify\n{output_var} = jsonify({input_var}).get_data(as_text=True)",
          "dependencies": ["flask"]
        }
      }
    },
    {
      "cell_id": "FLASK_RUN_DEBUG",
      "type": "micro",
      "stage": 4,
      "keywords": ["run", "start", "serve", "debug", "development", "localhost"],
      "inputs":  { "type_name": "Flask", "state": "routed_app" },
      "outputs": { "type_name": "str", "state": "server_started" },
      "domain_implementations": {
        "Python_Core": {
          "code": "if __name__ == '__main__':\n    {input_var}.run(host='0.0.0.0', port=5000, debug=True)\n{output_var} = 'Server started on port 5000'",
          "dependencies": ["flask"]
        }
      }
    },
    {
      "cell_id": "FLASK_ERROR_HANDLER",
      "type": "micro",
      "stage": 2,
      "keywords": ["error", "404", "500", "handler", "exception", "not found"],
      "inputs":  { "type_name": "Flask", "state": "app_instance" },
      "outputs": { "type_name": "Flask", "state": "routed_app" },
      "domain_implementations": {
        "Python_Core": {
          "code": "from flask import jsonify\n@{input_var}.errorhandler(404)\ndef not_found(e):\n    return jsonify({'error': 'Not found', 'code': 404}), 404\n@{input_var}.errorhandler(500)\ndef server_error(e):\n    return jsonify({'error': 'Internal server error', 'code': 500}), 500\n{output_var} = {input_var}",
          "dependencies": ["flask"]
        }
      }
    }
  ]
}
