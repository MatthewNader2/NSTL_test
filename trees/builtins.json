  "cells": [
    {
      "cell_id": "PY_LEN",
      "stage": 2,
      "domain_name": "builtins",
      "node_type": "function",
      "node_role": "transformer",
      "docstring": "Returns the number of items in a collection or sequence.",
      "keywords": ["len", "length", "count", "size", "elements", "contours", "items", "number"],
      "inputs": {
        "data": {
          "type_name": "collection",
          "abstract_type": "collection",
          "required": true,
          "port_role": "data_input",
          "description": "Container or sequence to measure."
        }
      },
      "outputs": {
        "result": {
          "type_name": "int",
          "state": "count",
          "abstract_type": "scalar",
          "description": "Number of elements in the container."
        }
      },
      "code_template": "{result} = len({data})",
      "primary_in": "data",
      "primary_out": "result"
    },
